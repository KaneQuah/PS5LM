diff --git a/tools/server/server-common.cpp b/tools/server/server-common.cpp
index 8cf794f1e..da738b536 100644
--- a/tools/server/server-common.cpp
+++ b/tools/server/server-common.cpp
@@ -1228,6 +1228,26 @@ json oaicompat_chat_params_parse(
 {
     json llama_params;
 
+    // PS5LM: the server's default system prompt (-sys, -sysf), for a request
+    // that carries none of its own. A client that sends a system message keeps
+    // it as it is.
+    if (!opt.system_prompt.empty() && body.contains("messages") && body.at("messages").is_array()) {
+        json & msgs = body.at("messages");
+        bool has_system = false;
+        for (const auto & m : msgs) {
+            const std::string r = json_value(m, "role", std::string());
+            has_system = has_system || r == "system" || r == "developer";
+        }
+        if (!has_system) {
+            json with_system = json::array();
+            with_system.push_back({ { "role", "system" }, { "content", opt.system_prompt } });
+            for (const auto & m : msgs) {
+                with_system.push_back(m);
+            }
+            body["messages"] = with_system;
+        }
+    }
+
     auto tools = json_value(body, "tools", json());
     auto has_tools = tools.is_array() && !tools.empty();
     auto stream = json_value(body, "stream", false);
